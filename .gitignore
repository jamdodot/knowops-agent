# 本地环境
.env
deploy/.env
.venv/
venv/

# WorkBuddy 项目级工作记忆（个人笔记，不进仓库）
.workbuddy/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 构建与临时产物（生成的契约代码是提交物，不在这里忽略）
build/
dist/
node_modules/

# Java 构建产物与上传落盘目录
target/
data/

# 离线录制：精确回放文件（recordings/{render_sha256}.json）是可再生产物，不提交；
# 但 mock_llm.yaml 是规则回放 fixture，测试与 smoke-m0 依赖它，必须提交
recordings/*.json
recordings/*.jsonl

# 跑批原始结果：一条命令就能重跑出来（见 eval/report-v2.md §7），1.9MB 的 JSON 不进仓库。
# 报告里引用的数字与复现命令都在 eval/report-*.md，需要原始数据时重跑即可。
eval/runs/*.json

# 个人学习资料，与项目无关
learning/

# IDE / OS
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# 本地临时产物（截图、调试输出）
.tmp/
