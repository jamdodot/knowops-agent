# 复制为 .env 后填入真实值。.env 已在 .gitignore 中，永不提交。
# 只需要两个 key 就能跑通全链路：DeepSeek 管生成，硅基流动管向量与重排。
# 文档解析全部本地跑，不需要任何 key。

# --- 生成 / 规划 / 判断 / 抽取 ---
DEEPSEEK_API_KEY=

# --- embedding + rerank ---
SILICONFLOW_API_KEY=

# --- 可选：embedding 模型 id（默认 BAAI/bge-m3）---
# EMBED_MODEL=BAAI/bge-m3

# --- 文档解析云 API（仅 parse_mode: hybrid 时才需要）---
# 默认 parse_mode: local，解析全部本地，这两项留空即可。
# 若改成 hybrid，只有扫描件/复杂版面那一路会走云端，届时再填。
MINERU_API_KEY=
MINERU_API_BASE=https://mineru.net/api/v4

# --- judge 模型（必须与生成模型异源，填硅基流动上一个非 DeepSeek 的强模型 id）---
JUDGE_MODEL=

# --- 生成链路的备用模型（硅基流动上挑一个，DeepSeek 挂了才用）---
GENERATE_FALLBACK_MODEL=

# --- CI 与断网演示：置 true 后不发起任何真实请求，走 recordings/ 回放 ---
MOCK_ENABLED=false

# --- 数据库 ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=knowops
POSTGRES_USER=knowops
POSTGRES_PASSWORD=knowops_dev_only

# --- 检索后端 ---
# 有 PG（下面五个 POSTGRES_* 齐了）→ 自动用 PgRetriever；缺一个 → 回落内存检索。
# 为什么不再单独配 KW_PG_DSN：密码会在两处出现，一旦不一致，psycopg 只会报
# "password authentication failed"，不会告诉你"你配了两个密码"（2026-11-04 踩到）。
# 需要连远端库时再显式给 KW_PG_DSN，它会优先生效。
# KW_PG_DSN=postgresql://knowops:<password>@localhost:5433/knowops
#
# dense 路的相似度下限：BGE-M3 在制度语料上，命中片段 0.62~0.78、噪声 0.49~0.55。
# 不设阈值会出现"越权查询也召回一堆不相干文档"，把权限拦截演成召回成功。
# KW_DENSE_MIN_SIM=0.55
#
# 可选：无 PG 时的演示语料目录（解析 + 分块 + 灌入内存检索）。
# 默认脚本 scripts/demo_knowledge.py 会指向 deploy/sample-corpus。
# KW_KNOWLEDGE_CORPUS=deploy/sample-corpus

# --- rerank（与 embedding 共用 SILICONFLOW_API_KEY，不需要单独申请）---
# KW_RERANK=0                     关闭重排（评测 A/B 用；不可用时自动跳回 RRF，并在响应里标 degraded）
# RERANK_MODEL=BAAI/bge-reranker-v2-m3
# RERANK_BASE=https://api.siliconflow.cn/v1
# 每路召回条数。必须明显大于 top_k，否则"融合 10 条再重排"等于白花钱。
# KW_RECALL_N=50
